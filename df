<div class="grow">
  <div class="gcolumn">
    <img src="assets/ABDUL_ELEX_FINAL.png" style="width:100%" onclick="myFunction(this);">
  </div>
  <div class="gcolumn">
    <img src="" style="width:100%" onclick="myFunction(this);">
  </div>
  <div class="gcolumn">
    <img src="" style="width:100%" onclick="myFunction(this);">
